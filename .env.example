# Copy to .env.local for local development. On Vercel, set these under
# Project > Settings > Environment Variables. Never commit real values.

# Web Push (VAPID) keys: generate a pair with `npm run vapid`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com or https://your-app.vercel.app
VAPID_SUBJECT=

# Any long random string (e.g. `openssl rand -hex 32`). Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# Redis for storing subscriptions + events (Upstash; added via Vercel Marketplace).
# Either naming scheme works: UPSTASH_REDIS_REST_* or KV_REST_API_*.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
