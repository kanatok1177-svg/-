# Copy to .env.local for local development. On Vercel, set these under
# Project > Settings > Environment Variables. Never commit real values.

# Redis for subscriptions + events (Upstash, added via the Vercel Marketplace; connecting it
# to the project sets these for you). Either naming scheme works: KV_REST_API_* or
# UPSTASH_REDIS_REST_*. Without Redis the notification button is hidden.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional hardening: letters/digits only, 16+ chars. When set, /api/cron/notify requires
# Vercel Cron's `Authorization: Bearer $CRON_SECRET`; when unset it accepts only Vercel Cron's
# user agent.
CRON_SECRET=

# Optional. VAPID keys are generated and stored in Redis automatically. To choose your own,
# create a pair with `npm run vapid` and set both (changing keys invalidates existing
# subscriptions, so turn notifications on again afterwards).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for push services (mailto:... or https://...). Defaults to your site URL.
VAPID_SUBJECT=
