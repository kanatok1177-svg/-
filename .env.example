# Copy to .env.local for local development. On Vercel, set these under
# Project > Settings > Environment Variables. Never commit real values.

# Required for push notifications: any string of 16+ letters/digits (no symbols, spaces
# or newlines). Vercel Cron sends it as a Bearer token to /api/cron/notify.
CRON_SECRET=

# Redis for subscriptions + events (Upstash, added via the Vercel Marketplace; it sets
# these for you). Either naming scheme works: UPSTASH_REDIS_REST_* or KV_REST_API_*.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. VAPID keys are generated and stored in Redis automatically. To choose your own,
# create a pair with `npm run vapid` and set both (changing keys invalidates existing
# subscriptions, so turn notifications on again afterwards).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for push services (mailto:... or https://...). Defaults to your site URL.
VAPID_SUBJECT=
